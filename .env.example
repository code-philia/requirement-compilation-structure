# Copy to .env; use a model that accepts image input.
MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.arc-bench.com/v1
# All stages use low reasoning, including implementation, repairs and image analysis.
# auto is an alias for low. provider requests no reasoning override.
MODEL_REASONING=low
VISUAL_REASONING=low
