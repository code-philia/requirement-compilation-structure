# Copy to .env; use a model that accepts image input.
MODEL=deepseek-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.arc-bench.com/v1
# auto: low reasoning for design/tests/test repairs; no thinking for code/code repairs/SQL.
# Other models keep provider defaults. Use provider to retain defaults everywhere.
MODEL_REASONING=auto
